generator client {
  provider        = "prisma-client-js"
  // Necesario para poder conectar con Turso (libSQL) en producción a través de
  // un driver adapter, en vez del acceso directo a fichero que usa SQLite normal.
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Directorio maestro de estancos (puntos de venta), importado desde el Excel
// real "Universo Comerciales". Datos de referencia, no gestionados desde la app.
model Estanco {
  id                 String   @id @default(cuid())
  idEstanco          String   @unique
  nombre             String
  direccion          String?
  municipio          String?
  codigoPostal       String?
  provincia          String?
  telefono           String?
  zona               String?
  frecuencia         String?
  segmento           String?
  comercial          String?
  telefonoComercial  String?
  comentarioComercial String?
  correoComercial    String?
  // Coordenadas geocodificadas (OpenStreetMap/Nominatim) para calcular la
  // distancia aproximada al técnico.
  lat                Float?
  lon                Float?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  incidencias Incidencia[]
}

// Rol: TECNICO | ADMIRA | FDM
model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  role      String
  name      String
  email     String?
  phone     String?
  zona      String?
  direccion String?
  // Datos operativos del técnico (importados de la hoja "New Técnicos").
  codigoPostal      String?
  personaContacto   String?
  horario           String?
  radioCobertura    String?
  costeKm           String?
  condiciones       String?
  // Coordenadas geocodificadas de `direccion` (OpenStreetMap/Nominatim), para
  // calcular la distancia aproximada a cada incidencia.
  lat       Float?
  lon       Float?
  active    Boolean  @default(true)
  // Los usuarios creados con contraseña temporal (p. ej. los técnicos
  // importados) deben cambiarla la primera vez que entran.
  debeCambiarPassword Boolean @default(false)
  passwordCambiadaAt  DateTime?
  createdAt DateTime @default(now())

  tokensReset       PasswordResetToken[]
  materiales        Material[]        @relation("MaterialTecnico")
  enviosDestino     Envio[]           @relation("EnvioTecnico")
  enviosCreados     Envio[]           @relation("EnvioCreadoPor")
  incidenciasAsig   Incidencia[]      @relation("IncidenciaTecnico")
  incidenciasCread  Incidencia[]      @relation("IncidenciaCreadoPor")
  materialEventos   MaterialEvento[]
  ordenesRecurrentes OrdenRecurrente[] @relation("OrdenRecurrenteTecnico")
  ordenesCreadas     OrdenRecurrente[] @relation("OrdenRecurrenteCreadoPor")

  // Historial de importaciones de datos
  estancoImportaciones EstancoImportHistory[] @relation("EstancoImportaciones")
  instalacionImportaciones InstalacionImportHistory[] @relation("InstalacionImportaciones")

  notificaciones     Notificacion[]
  pushSuscripciones  PushSubscription[]
}

// Token de un solo uso para restablecer la contraseña por email.
// Se guarda hasheado: si alguien accediera a la base de datos, no podría
// usar los tokens pendientes para entrar en las cuentas.
model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiraAt  DateTime
  usadoAt   DateTime?
  createdAt DateTime @default(now())
}

// Orden de envío recurrente: cada X días se genera automáticamente un envío
// del material configurado hacia el técnico.
model OrdenRecurrente {
  id            String    @id @default(cuid())
  tecnicoId     String
  tecnico       User      @relation("OrdenRecurrenteTecnico", fields: [tecnicoId], references: [id])
  frecuenciaDias Int
  transportista String    @default("MARESA")
  // De qué almacén (FDM o Admira) sale el material en cada envío que genere.
  almacen       String    @default("FDM")
  // Tipos de material a reponer y cuántas unidades de cada uno, en JSON:
  // [{ "tipo": "PANTALLA", "cantidad": 2 }, ...]
  materialConfig String
  activa        Boolean   @default(true)
  notas         String?
  ultimaEjecucion DateTime?
  proximaEjecucion DateTime
  creadoPorId   String?
  creadoPor     User?     @relation("OrdenRecurrenteCreadoPor", fields: [creadoPorId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  envios Envio[]
}

// tipo: PANTALLA | ROUTER | REPRODUCTOR | SOPORTE | CABLEADO | MOBILIARIO | OTRO
// estado: EN_FDM | EN_ADMIRA | EN_TRANSITO_ENVIO | EN_TECNICO | EN_TRANSITO_RECOGIDA | EN_TRANSITO_TRANSFERENCIA | INSTALADO | BAJA
model Material {
  id           String   @id @default(cuid())
  // Identificador real del material: así es como Admira lo trackea y como
  // aparece en el Excel de stock. Puede rellenarse escaneando el código de
  // barras de la etiqueta (muchos fabricantes codifican ahí el propio número
  // de serie) o haciendo una foto con el lector OCR.
  numeroSerie  String   @unique
  tipo         String
  // Cuando el tipo es "OTRO", aquí se guarda qué es exactamente
  // (lo escribe quien da de alta el material).
  tipoPersonalizado String?
  nombre       String
  descripcion  String?
  estado       String   @default("EN_FDM")
  tecnicoId    String?
  tecnico      User?    @relation("MaterialTecnico", fields: [tecnicoId], references: [id])
  ubicacion    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  envioItems     EnvioItem[]
  eventos        MaterialEvento[]
  incidenciaUsos IncidenciaMaterial[]
}

// tipo: ALTA | ENVIO_PREPARADO_FDM | RECEPCION_TECNICO | INSTALACION | RECOGIDA_TECNICO | DEVOLUCION_FDM | BAJA
model MaterialEvento {
  id           String    @id @default(cuid())
  materialId   String
  material     Material  @relation(fields: [materialId], references: [id])
  tipo         String
  fecha        DateTime  @default(now())
  usuarioId    String?
  usuario      User?     @relation(fields: [usuarioId], references: [id])
  envioId      String?
  incidenciaId String?
  notas        String?
}

// tipo: ENVIO (almacén → técnico) | RECOGIDA (técnico → almacén) |
//       TRANSFERENCIA (almacén → almacén, sin técnico de por medio)
// transportista: MARESA | RENUS | OTRO
// estado: PENDIENTE_PREPARACION | ENVIADO | EN_TRANSITO | RECIBIDO | INCIDENCIA
//   (INCIDENCIA: la confirmación en origen o destino se cerró sin que
//   coincidiera del todo con lo pedido/enviado — hace falta revisión manual)
// almacen: FDM | ADMIRA — en ENVIO/RECOGIDA es el almacén que hace de
// contraparte del técnico; en TRANSFERENCIA es el almacén de ORIGEN (el
// destino es siempre el otro almacén, ya que solo hay dos).
model Envio {
  id            String    @id @default(cuid())
  tipo          String    @default("ENVIO")
  transportista String    @default("MARESA")
  origen        String
  destino       String
  almacen       String    @default("FDM")
  // No aplica en TRANSFERENCIA (almacén → almacén, sin técnico).
  tecnicoId     String?
  tecnico       User?     @relation("EnvioTecnico", fields: [tecnicoId], references: [id])
  estado        String    @default("PENDIENTE_PREPARACION")
  esRecurrente  Boolean   @default(false)
  // Si viene de una orden recurrente, queda vinculado a ella para trazabilidad.
  ordenRecurrenteId String?
  ordenRecurrente   OrdenRecurrente? @relation(fields: [ordenRecurrenteId], references: [id])
  // Lo que se ha pedido, por categoría: [{ "tipo": "PANTALLA", "cantidad": 24 }, ...].
  // No se eligen piezas concretas al crear el envío — esas se van enlazando
  // una a una según se escanean en origen (ver EnvioItem), así queda registro
  // exacto de qué unidad física se mandó y luego se comprueba contra lo que
  // se escanea en destino.
  pedido        String
  notas         String?
  creadoPorId   String?
  creadoPor     User?     @relation("EnvioCreadoPor", fields: [creadoPorId], references: [id])
  fechaCreacion DateTime  @default(now())
  fechaEnviado  DateTime?
  fechaRecibido DateTime?

  items EnvioItem[]
}

model EnvioItem {
  id                  String    @id @default(cuid())
  envioId             String
  envio               Envio     @relation(fields: [envioId], references: [id])
  materialId          String
  material             Material  @relation(fields: [materialId], references: [id])
  escaneadoOrigen      Boolean   @default(false)
  fechaEscaneoOrigen   DateTime?
  escaneadoDestino     Boolean   @default(false)
  fechaEscaneoDestino  DateTime?
}

// tipo: INSTALACION_NUEVA | REPARACION | MANTENIMIENTO
// estado: SIN_ASIGNAR | ASIGNADA | EN_CAMINO | RESUELTA
// origen: MANUAL | DESK
model Incidencia {
  id              String    @id @default(cuid())
  ticketExternoId String?
  // Datos de la integración con el desk de tickets (api.desk.admira.com).
  origen          String    @default("MANUAL")
  deskTicketId    String?   @unique
  deskProyecto    String?
  deskEstado      String?
  titulo          String
  descripcion     String?
  tipo            String    @default("REPARACION")
  cliente         String?
  direccion       String?
  tecnicoId       String?
  tecnico         User?     @relation("IncidenciaTecnico", fields: [tecnicoId], references: [id])
  estado          String    @default("ASIGNADA")
  creadoPorId     String?
  creadoPor       User?     @relation("IncidenciaCreadoPor", fields: [creadoPorId], references: [id])
  fechaAsignacion DateTime?
  fechaEnCamino   DateTime?
  fechaResuelta   DateTime?
  fechaImportada  DateTime  @default(now())

  // Vínculo (best-effort, por coincidencia de texto) con el directorio real de
  // estancos, para poder avisar automáticamente al comercial correspondiente.
  estancoId              String?
  estanco                Estanco?  @relation(fields: [estancoId], references: [id])
  estancoMatchConfianza  Float?
  fechaVisitaProgramada  DateTime?
  comercialAvisadoProgramada Boolean @default(false)
  comercialAvisadoEnCamino   Boolean @default(false)

  fotos            FotoEvidencia[]
  materialesUsados IncidenciaMaterial[]
  notificaciones   NotificacionComercial[]
}

// Log de los avisos automáticos enviados al comercial de un estanco.
// tipo: PROGRAMADA | EN_CAMINO
model NotificacionComercial {
  id           String     @id @default(cuid())
  incidenciaId String
  incidencia   Incidencia @relation(fields: [incidenciaId], references: [id])
  tipo         String
  destinatario String?
  estado       String // ENVIADO | SIMULADO | ERROR
  detalle      String?
  fecha        DateTime   @default(now())
}

model FotoEvidencia {
  id           String     @id @default(cuid())
  incidenciaId String
  incidencia   Incidencia @relation(fields: [incidenciaId], references: [id])
  url          String
  fecha        DateTime   @default(now())
}

model IncidenciaMaterial {
  id           String     @id @default(cuid())
  incidenciaId String
  incidencia   Incidencia @relation(fields: [incidenciaId], references: [id])
  materialId   String
  material     Material   @relation(fields: [materialId], references: [id])
  fecha        DateTime   @default(now())
}

// Historial de importaciones del Universo de Comerciales (estancos).
// Se registra cada vez que se sube el Excel mensual.
model EstancoImportHistory {
  id                String   @id @default(cuid())
  usuarioId         String
  usuario           User     @relation("EstancoImportaciones", fields: [usuarioId], references: [id])
  fechaImportacion  DateTime @default(now())

  // Resumen de la importación
  totalFilas        Int      // Total de filas procesadas del Excel
  estancosCreados   Int      // Nuevos estancos
  estancosActualizados Int  // Estancos existentes que cambiaron
  estancosSaltados  Int      // Filas inválidas/incompletas

  // Detalles
  erroresValidacion String?  // JSON con errores encontrados
  detalles          String?  // Notas del proceso

  archivoNombre     String   // Nombre del archivo subido
  createdAt         DateTime @default(now())
}

// Historial de importaciones de instalaciones semanales (Altadis).
// Se registra cada vez que se sube el Excel de instalaciones del jueves.
model InstalacionImportHistory {
  id                String   @id @default(cuid())
  usuarioId         String
  usuario           User     @relation("InstalacionImportaciones", fields: [usuarioId], references: [id])
  fechaImportacion  DateTime @default(now())

  // Resumen de la importación
  totalFilas        Int      // Total de filas procesadas del Excel
  incidenciasCreadas Int     // Nuevas incidencias generadas
  incidenciasActualizadas Int // Incidencias existentes que cambiaron estado
  instalacionesSaltadas Int    // Filas inválidas/incompletas

  // Detalles
  erroresValidacion String?  // JSON con errores encontrados
  detalles          String?  // Notas del proceso

  archivoNombre     String   // Nombre del archivo subido
  createdAt         DateTime @default(now())
}

// Notificación dirigida a un usuario concreto (campanita en la app). Cada
// evento relevante (envío creado/recibido, incidencia asignada/en camino/
// resuelta, tickets nuevos del desk, limpieza mensual completada...) crea una
// fila aquí para la persona directamente afectada, y opcionalmente dispara
// también una notificación push si tiene alguna suscripción activa.
// tipo: ENVIO_CREADO | ENVIO_EN_CAMINO | ENVIO_RECIBIDO | INCIDENCIA_ASIGNADA |
//       INCIDENCIA_EN_CAMINO | INCIDENCIA_RESUELTA | INCIDENCIAS_DESK_NUEVAS |
//       LIMPIEZA_COMPLETADA
// entidadTipo: envio | incidencia (para poder enlazar al detalle al hacer clic)
model Notificacion {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  tipo        String
  titulo      String
  mensaje     String
  leida       Boolean   @default(false)
  entidadTipo String?
  entidadId   String?
  createdAt   DateTime  @default(now())

  @@index([userId, leida])
}

// Suscripción a notificaciones push del navegador (Web Push API). Un mismo
// usuario puede tener varias (un móvil, un ordenador...); cada una guarda las
// claves que exige el estándar para poder cifrar el envío.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

// Historial de limpiezas automáticas mensuales (borrado de fotos resueltas).
// Se registra para auditoría y seguimiento.
model CleanupLog {
  id                    String   @id @default(cuid())

  // Resumen de la limpieza
  fotosMovidas          Int      // Fotos copiadas a backup
  fotosEliminadas       Int      // Fotos borradas de producción
  backupsLimpiados      Int      // Directorios de backup (>1 año) eliminados

  // Detalles
  erroresCount          Int      @default(0)
  detalles              String?  // JSON con errores encontrados (si los hay)

  // Auditoría
  ejecutadoEn           DateTime @default(now())
  tiempoEjecucion       Int?     // Segundos que tardó
  createdAt             DateTime @default(now())
}
